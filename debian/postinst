#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if [ -x /usr/share/sddm-authelia-passkey/install-theme.sh ]; then
        /usr/share/sddm-authelia-passkey/install-theme.sh
    fi

    if [ -x /usr/share/sddm-authelia-passkey/validate-branding-overrides.sh ]; then
        /usr/share/sddm-authelia-passkey/validate-branding-overrides.sh
    fi

    echo "sddm-authelia-passkey: installed."
    echo "PAM integration is NOT automatic."
    echo "SDDM was NOT restarted."
    echo "Next steps:"
    echo "  1. Edit /etc/sddm-authelia-passkey/config.conf (see config.conf.example)"
    echo "  2. sudo /usr/share/sddm-authelia-passkey/preflight.sh"
    echo "  3. sudo /usr/share/sddm-authelia-passkey/enable-pam.sh"
    echo "  4. sudo systemctl enable --now sddm-authelia-passkey-broker.service"
    echo "See /usr/share/doc/sddm-authelia-passkey/installation.md for the full guide."
fi

#DEBHELPER#
exit 0
