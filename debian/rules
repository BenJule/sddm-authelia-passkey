#!/usr/bin/make -f

export DH_VERBOSE = 1
export GOFLAGS = -mod=mod

# -trimpath: strip the local build path (e.g. the builder's home
# directory) that Go otherwise embeds for stack traces.
# -buildmode=pie + external linker + -Wl,-z,relro,-z,now: match the same
# PIE/full-RELRO/BIND_NOW hardening already required of src/pam's C
# module (see src/pam/Makefile) - Go's internal linker alone produces a
# PIE binary with only partial RELRO (no BIND_NOW) by default.
GO_HARDENING_FLAGS := -trimpath -buildmode=pie -ldflags "-linkmode=external -extldflags=-Wl,-z,relro,-z,now"

%:
	dh $@ --no-automatic-dbgsym

override_dh_auto_build:
	cd src/broker && go build $(GO_HARDENING_FLAGS) -o broker .
	cd src/kwallet-secretd && go build $(GO_HARDENING_FLAGS) -o kwallet-secretd .
	$(MAKE) -C src/pam

override_dh_auto_test:
	cd src/broker && go test ./...
	cd src/kwallet-secretd && go test ./...

override_dh_auto_install:
	install -D -m 0755 src/broker/broker debian/sddm-authelia-passkey/usr/lib/sddm-authelia-passkey/broker
	install -D -m 0755 src/kwallet-secretd/kwallet-secretd debian/sddm-authelia-passkey/usr/lib/sddm-authelia-passkey/kwallet-secretd
	install -D -m 0644 src/pam/pam_authelia_passkey.so debian/sddm-authelia-passkey/usr/lib/x86_64-linux-gnu/security/pam_authelia_passkey.so
	install -D -m 0644 systemd/sddm-authelia-passkey-broker.service debian/sddm-authelia-passkey/usr/lib/systemd/system/sddm-authelia-passkey-broker.service
	install -D -m 0644 systemd/sddm-authelia-passkey-kwallet-secretd.service debian/sddm-authelia-passkey/usr/lib/systemd/system/sddm-authelia-passkey-kwallet-secretd.service
	install -D -m 0644 config/examples/config.conf.example debian/sddm-authelia-passkey/etc/sddm-authelia-passkey/config.conf.example
	install -D -m 0755 scripts/preflight.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/preflight.sh
	install -D -m 0755 scripts/postflight.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/postflight.sh
	install -D -m 0755 scripts/enable-pam.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/enable-pam.sh
	install -D -m 0755 scripts/rollback.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/rollback.sh
	install -D -m 0755 scripts/setup-kwallet-credential.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/setup-kwallet-credential.sh
	install -D -m 0755 scripts/install-theme.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/install-theme.sh
	install -D -m 0755 scripts/enable-fido2.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/enable-fido2.sh
	install -D -m 0755 scripts/disable-fido2.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/disable-fido2.sh
	install -D -m 0755 scripts/setup-fido2-credential.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/setup-fido2-credential.sh
	install -D -m 0755 scripts/revoke-fido2-credential.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/revoke-fido2-credential.sh
	install -D -m 0755 scripts/list-fido2-credentials.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/list-fido2-credentials.sh
	install -D -m 0755 scripts/disable-pam.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/disable-pam.sh
	install -D -m 0755 scripts/break-glass.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/break-glass.sh
	install -D -m 0755 scripts/sddm-authelia-passkey-admin.sh debian/sddm-authelia-passkey/usr/sbin/sddm-authelia-passkey-admin
	install -D -m 0644 debian/sddm-authelia-passkey-admin.8 debian/sddm-authelia-passkey/usr/share/man/man8/sddm-authelia-passkey-admin.8
	install -D -m 0644 scripts/lib/credstore-dir.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/lib/credstore-dir.sh
	install -D -m 0644 scripts/lib/theme-selection.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/lib/theme-selection.sh
	install -D -m 0644 scripts/lib/fido2-authfile.sh debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/lib/fido2-authfile.sh
	install -D -m 0644 theme/debian-breeze-authelia-passkey-patch/Main.qml.patch debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/theme/Main.qml.patch
	install -D -m 0644 theme/debian-breeze-authelia-passkey-patch/metadata.desktop.patch debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/theme/metadata.desktop.patch
	install -D -m 0644 theme/debian-breeze-authelia-passkey-patch/theme.conf.user.example debian/sddm-authelia-passkey/usr/share/sddm-authelia-passkey/theme/theme.conf.user.example
	# v1.9.0: the native theme is fully original, static content (no
	# patch against a pristine system theme, unlike the compatibility
	# theme above) - install it directly as regular package-owned
	# files. dpkg then tracks and removes them automatically on
	# purge/remove, no runtime install/cleanup script needed. Package
	# installation never touches /etc/sddm.conf(.d) - this only makes
	# the theme available, it does not select it.
	install -D -m 0644 theme/native/Main.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/Main.qml
	install -D -m 0644 theme/native/metadata.desktop debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/metadata.desktop
	install -D -m 0644 theme/native/theme.conf debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/theme.conf
	install -D -m 0644 theme/native/components/UserAvatar.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/UserAvatar.qml
	install -D -m 0644 theme/native/components/PowerActionsRow.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/PowerActionsRow.qml
	install -D -m 0644 theme/native/components/ResponsiveMetrics.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/ResponsiveMetrics.qml
	install -D -m 0644 theme/native/components/PolishedButton.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/PolishedButton.qml
	install -D -m 0644 theme/native/components/PolishedTextField.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/PolishedTextField.qml
	install -D -m 0644 theme/native/components/PolishedComboBox.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/PolishedComboBox.qml
	install -D -m 0644 theme/native/components/UserChooser.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/UserChooser.qml
	install -D -m 0644 theme/native/components/SmartphoneFlowController.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/SmartphoneFlowController.qml
	install -D -m 0644 theme/native/components/ConnectionStatus.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/ConnectionStatus.qml
	install -D -m 0644 theme/native/components/CountdownView.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/CountdownView.qml
	install -D -m 0644 theme/native/components/SmartphoneLoginPanel.qml debian/sddm-authelia-passkey/usr/share/sddm/themes/sddm-authelia-passkey-native/components/SmartphoneLoginPanel.qml

override_dh_installdocs:
	dh_installdocs docs/*.md README.md

override_dh_installsystemd:
	# Do not start/enable services on a fresh install, but if an admin
	# already has a project service running, an in-place package upgrade
	# must not stop it and leave it inactive.
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade

override_dh_dwz:
	# Go binaries carry compressed .debug_abbrev sections dwz cannot
	# process, and the PAM module has no separate debug info for it to
	# multifile-optimize against - skip dwz entirely for this package.
