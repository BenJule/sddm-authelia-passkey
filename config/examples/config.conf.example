# sddm-authelia-passkey configuration
#
# Installed at /etc/sddm-authelia-passkey/config.conf (root:root, 0644 -
# contains no secrets, only endpoints and policy). Simple KEY=VALUE format
# on purpose: parsed identically by the Go broker/secretd and the C PAM
# module without pulling in a TOML/YAML library on either side.
#
# Lines starting with # are comments. No quoting, no multi-line values.

# Base URL of your Authelia (or compatible OIDC provider) instance.
# Must be https:// unless authelia_dev_insecure_http=true (see below).
authelia_base_url=https://idp.example.com

# OIDC client configured in Authelia for the Device Authorization Grant
# (RFC 8628). See docs/installation.md for the required Authelia client
# config (grant type, scopes, redirect none needed).
oidc_client_id=pam-authelia
oidc_scopes=openid authelia.pam

# Hostname the verification_uri_complete returned by Authelia must match.
# Kept separate from authelia_base_url so a reverse-proxy/CDN front-end
# can't silently redirect the QR code somewhere else without this also
# being updated deliberately.
allowed_verification_host=idp.example.com

# Set to true ONLY for local development against a plain-HTTP test
# instance. Refused by the broker at startup otherwise (fail closed).
authelia_dev_insecure_http=false

# Comma-separated local usernames allowed to use the smartphone/passkey
# passwordless path. Every other account (including root, always) keeps password-only
# login - this list is additive, never a replacement for the password path.
allowed_users=alice,bob

# Device-authorization approval marker lifetime, in seconds. A completed
# approval must be consumed by PAM within this window or it is discarded.
approval_ttl_seconds=30

# Minimum seconds between two device-authorization attempts for the same
# user.
user_cooldown_seconds=10

# Maximum number of concurrent in-flight device-authorization sessions,
# across all users.
max_parallel_flows=3

# After this many consecutive denied/expired approvals for a user, lock
# that user out of the smartphone/passkey path for failure_lockout_seconds.
failure_lockout_threshold=3
failure_lockout_seconds=60

# Optional: automatically unlock a running KDE KWallet on a successful
# smartphone/passkey login. Requires a one-time interactive setup per
# allowed user (see docs/kwallet.md and scripts/setup-kwallet-credential.sh)
# and a systemd-creds encrypted credential. Off by default - a failed or
# unavailable credential never blocks login either way, it only means
# KWallet falls back to its normal manual password prompt.
kwallet_auto_unlock=false

# Prefix only, not a filename: each allowed user has their own
# systemd-creds encrypted credential named "<prefix>.<username>" (e.g.
# kwallet.secret.alice) - never one credential shared across users.
kwallet_credential_name=kwallet.secret
