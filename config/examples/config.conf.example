# sddm-authelia-passkey configuration
#
# Installed at /etc/sddm-authelia-passkey/config.conf (root:root, 0644 -
# contains no secrets, only endpoints and policy). Simple KEY=VALUE format
# on purpose: parsed identically by the Go broker/secretd and the C PAM
# module without pulling in a TOML/YAML library on either side.
#
# Lines starting with # are comments. No quoting, no multi-line values.

# Which OIDC Device Authorization Grant (RFC 8628) provider to talk to:
#   authelia (default) - unchanged from v0.1-v0.6, uses authelia_base_url
#     below with Authelia's own hardcoded endpoint paths and identity
#     claim ("authelia.pam.username").
#   oidc - any standards-compliant provider that publishes an OIDC
#     discovery document advertising device_authorization_endpoint
#     (Keycloak, Authentik, or any other OIDC Provider) - uses
#     oidc_discovery_url/oidc_identity_claim below instead of
#     authelia_base_url. See docs/architecture.md's "Provider
#     abstraction" section.
provider_kind=authelia

# Base URL of your Authelia instance. Required (and only consulted) when
# provider_kind=authelia. Must be https:// unless
# authelia_dev_insecure_http=true (see below).
authelia_base_url=https://idp.example.com

# Required (and only consulted) when provider_kind=oidc: the provider's
# discovery document URL (its .well-known/openid-configuration). If it
# does not advertise device_authorization_endpoint, the broker refuses
# to start rather than guess at a conventional path.
#oidc_discovery_url=https://idp.example.com/.well-known/openid-configuration

# Which userinfo claim carries the local username to bind to. Only
# consulted when provider_kind=oidc (authelia mode always uses its own
# "authelia.pam.username"). Defaults to the standard OIDC
# "preferred_username" claim if left unset - most providers, including
# Keycloak and Authentik, populate it with the account's login name.
#oidc_identity_claim=preferred_username

# OIDC client configured on your provider for the Device Authorization
# Grant (RFC 8628). See docs/installation.md for the required Authelia
# client config (grant type, scopes, redirect none needed); for
# Keycloak/Authentik/generic OIDC, configure a public client with the
# Device Authorization Grant enabled and matching scopes.
oidc_client_id=pam-authelia
oidc_scopes=openid authelia.pam

# Hostname the verification_uri_complete returned by Authelia must match.
# Kept separate from authelia_base_url so a reverse-proxy/CDN front-end
# can't silently redirect the QR code somewhere else without this also
# being updated deliberately.
allowed_verification_host=idp.example.com

# Set to true ONLY for local development against a plain-HTTP test
# instance. Refused by the broker at startup otherwise (fail closed).
authelia_dev_insecure_http=false

# How a requested username is authorized to use the smartphone/passkey
# path at all (separate from the later exact-match check against the
# OIDC identity Authelia actually approves - see docs/architecture.md):
#
#   local (default) - unchanged from v0.1-v0.4: the account must be a
#     literal entry in allowed_users below, nothing else is checked.
#
#   nss - any account NSS can resolve is eligible (local /etc/passwd, or
#     - if this host's own /etc/nsswitch.conf has "passwd: files sss" and
#     SSSD is configured against Samba AD/OpenLDAP/FreeIPA - a directory
#     account), subject to minimum_uid/deny_users/allowed_groups below.
#     This broker never talks to LDAP/AD/SSSD directly and never caches
#     directory credentials itself - it only ever calls the same NSS
#     lookups (getpwnam/getgrouplist) any other PAM-aware program would,
#     and fails closed if they error or are unavailable.
account_source=local

# Comma-separated local usernames allowed to use the smartphone/passkey
# passwordless path. Every other account (including root, always) keeps password-only
# login - this list is additive, never a replacement for the password path.
#
# Required (non-empty) when account_source=local. Optional when
# account_source=nss - if set there, it further restricts an
# already-NSS-eligible account to just these names; if left empty, any
# account passing the checks below is eligible.
allowed_users=alice,bob

# The following four settings are only consulted when account_source=nss.

# Reject any resolved account whose UID is below this value. UID 0
# (root) is always rejected regardless of this setting.
minimum_uid=1000

# Comma-separated usernames never eligible, checked before anything else
# below. "root" is always implicitly included whether or not it is
# listed here.
deny_users=root

# Comma-separated group names - if non-empty, the resolved account must
# be a member of at least one of them (via real NSS group membership,
# e.g. an AD/LDAP "linux-login" group via SSSD - never a cache this
# project maintains itself).
allowed_groups=linux-login

# Must be true (the only supported value) whenever allowed_groups is
# non-empty - an explicit switch rather than silently ignoring an empty
# allowed_groups list, so a half-finished config fails to start instead
# of guessing what was meant.
require_group_match=true

# Device-authorization approval marker lifetime, in seconds. A completed
# approval must be consumed by PAM within this window or it is discarded.
approval_ttl_seconds=30

# Minimum seconds between two device-authorization attempts for the same
# user.
user_cooldown_seconds=10

# Maximum number of concurrent in-flight device-authorization sessions,
# across all users.
max_parallel_flows=3

# After this many consecutive denied/expired approvals for a user, lock
# that user out of the smartphone/passkey path for failure_lockout_seconds.
failure_lockout_threshold=3
failure_lockout_seconds=60

# Optional: automatically unlock a running KDE KWallet on a successful
# smartphone/passkey login. Requires a one-time interactive setup per
# allowed user (see docs/kwallet.md and scripts/setup-kwallet-credential.sh)
# and a systemd-creds encrypted credential. Off by default - a failed or
# unavailable credential never blocks login either way, it only means
# KWallet falls back to its normal manual password prompt.
kwallet_auto_unlock=false

# Prefix only, not a filename: each allowed user has their own
# systemd-creds encrypted credential named "<prefix>.<username>" (e.g.
# kwallet.secret.alice) - never one credential shared across users.
kwallet_credential_name=kwallet.secret

# Optional: native FIDO2/U2F hardware security key (YubiKey, Nitrokey,
# SoloKey, etc.) as a fast local login path, tried before the smartphone/
# passkey flow and the password fallback. Off by default - requires
# `apt install libpam-u2f` and running
# /usr/share/sddm-authelia-passkey/enable-fido2.sh once (after
# enable-pam.sh). See docs/fido2.md. These four values only take effect
# once enable-fido2.sh has actually wired pam_u2f.so into the PAM stack.
fido2_authfile=/etc/sddm-authelia-passkey/fido2_mappings
fido2_require_user_verification=true
fido2_require_pin_verification=false
