[Unit]
Description=KWallet secret release daemon for sddm-authelia-passkey (optional)
After=sddm-authelia-passkey-broker.service
Requires=sddm-authelia-passkey-broker.service

[Service]
Type=simple
ExecStart=/usr/lib/sddm-authelia-passkey/kwallet-secretd
# Per-user credentials: no default LoadCredentialEncrypted= is baked
# into this unit. `setup-kwallet-credential.sh <user>` creates both the
# encrypted credential and a dedicated root-owned systemd drop-in with
# the matching LoadCredentialEncrypted= entry, then reloads/restarts this
# service. Credentials are never automatically mapped between users.
# See docs/kwallet.md.
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/sddm-authelia-passkey

[Install]
WantedBy=multi-user.target
